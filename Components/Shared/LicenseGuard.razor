@using SoftPos.Services
@inject NavigationManager Navigation

@if (isLicenseValid)
{
    @ChildContent
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Error" Class="mb-4">
                🔒
            </MudText>
            
            <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Error" Class="mb-4">
                البرنامج غير مفعّل
            </MudText>

            <MudAlert Severity="Severity.Error" Class="mb-4">
                <strong>تنبيه:</strong> هذا البرنامج غير مفعّل على هذا الجهاز.<br/>
                يرجى تفعيل البرنامج للمتابعة واستخدام جميع المميزات.
            </MudAlert>

            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                للحصول على الترخيص، يرجى التواصل مع المطور أو الضغط على زر التفعيل.
            </MudText>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/license-activation"
                       StartIcon="@Icons.Material.Filled.VpnKey">
                🔑 الذهاب لصفحة التفعيل
            </MudButton>
        </MudPaper>
    </MudContainer>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool isLicenseValid = false;

    protected override void OnInitialized()
    {
        isLicenseValid = LicenseService.ValidateLicense();
    }
}
