@code {
    private UserMaster? currentUser;
    private string userRole = "";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetCurrentUser();
        userRole = currentUser?.Role ?? "";
    }

    private bool CanAccess(params string[] allowedRoles)
    {
        if (string.IsNullOrEmpty(userRole)) return false;
        if (userRole == "Admin") return true; // Admin has access to everything
        return allowedRoles.Contains(userRole);
    }

    private bool IsAdmin() => userRole == "Admin";
    private bool IsSales() => userRole == "Sales" || userRole == "Counter" || userRole == "Pos";
    private bool IsPurchase() => userRole == "Purchase";
    private bool IsAccountant() => userRole == "Accountant";
    private bool IsCounter() => userRole == "Counter" || userRole == "Pos";
}
