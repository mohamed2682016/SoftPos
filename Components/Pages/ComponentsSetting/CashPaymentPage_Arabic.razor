@using System.Security.Claims;
@inject PaymentInService paymentinService
@inject SalesRegisterService _register
@inject SalesInvoiceService salesInvoiceService
@inject InvoiceSettingService invoiceSettingService
@inject UserService userService
@inject CompanyService companyService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@using SoftPos.Utilities
<div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="fa-solid fa-tags me-2"></i> تفاصيل الدفع
                </h5>
                <button type="button" class="btn-close text-white" @onclick="CloseModal" aria-label="إغلاق"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <div class="row g-3">

                    <!-- Left Section -->
                    <div class="col-md-6">
                        @if (customerBalance > 0)
                        {
                            <div class="alert alert-warning mb-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-exclamation-triangle me-2"></i><strong>رصيد العميل الحالي:</strong></span>
                                    <span class="fw-bold fs-5">@customerBalance.ToString("N2") ج.م</span>
                                </div>
                            </div>
                        }
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">المبلغ المستحق</label>
                            <input type="text" @bind="master.GrandTotal" class="form-control form-control-lg text-end fw-bold" required readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">المبلغ المدفوع</label>
                            <input type="number" @bind="decTendered" @bind:event="oninput" @onkeyup="CalculateTender" @onchange="CalculateTender" class="form-control form-control-lg text-end">
                        </div>
                        
                        @if (excessAmount > 0)
                        {
                            <div class="alert alert-success mb-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-check-circle me-2"></i><strong>سيتم خصم من الديون:</strong></span>
                                    <span class="fw-bold fs-5">@excessAmount.ToString("N2") ج.م</span>
                                </div>
                                @if (remainingDebt > 0)
                                {
                                    <div class="mt-2 text-muted small">
                                        <i class="fas fa-info-circle me-1"></i>
                                        الرصيد المتبقي بعد الخصم: @remainingDebt.ToString("N2") ج.م
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-2 text-success small">
                                        <i class="fas fa-check-circle me-1"></i>
                                        سيتم سداد كامل الديون!
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">ملاحظات</label>
                            <textarea @bind="master.Narration" class="form-control" rows="3" placeholder="أضف أي ملاحظات هنا..."></textarea>
                        </div>
                    </div>

                    <!-- Right Section -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                @if (CashChange == 0)
                                {
                                    <span>المبلغ المتبقي</span>
                                }
                                else
                                {
                                    <span>الباقي المطلوب إرجاعه</span>
                                }
                            </label>
                            <input type="text" @bind="CashChange" class="form-control form-control-lg text-end text-success fw-bold" readonly>
                        </div>

                        <!-- Embedded Calculator -->
                        <div class="mt-4">
                            <Calculator OnButtonClick="HandleChildButtonClick"></Calculator>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer d-flex justify-content-end">
                <button id="submit-btn" type="button" @onclick="Save" class="btn btn-primary btn-lg px-4" disabled="@(isProcessing)">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>جاري المعالجة...</span>
                    }
                    else
                    {
                        @if (type == "Cash")
                        {
                            <i class="fa-solid fa-money-bill me-2"></i>
                            <span>نقدي</span>
                        }
                        else if (type == "Card")
                        {
                            <i class="fa-solid fa-credit-card me-2"></i>
                            <span>بطاقة</span>
                        }
                        else if (type == "UPI")
                        {
                            <i class="fa-solid fa-wallet me-2"></i>
                            <span>محفظة</span>
                        }
                        else if (type == "Hold")
                        {
                            <i class="fas fa-pause me-1"></i>
                            <span>تعليق</span>
                        }
                        else if (type == "CreditSales")
                        {
                            <i class="fa-solid fa-handshake me-2"></i>
                            <span>مبيعات آجلة</span>
                        }
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<int> OnButtonClick { get; set; }
    [Parameter]
    public SalesMaster master { get; set; } = new();
    [Parameter]
    public string type { get; set; }
    [Parameter]
    public List<ProductView> productList { get; set; } = new();
    [Parameter]
    public List<DeleteItem> deleteNo { get; set; } = new();
    bool isProcessing;
    //CreditNotes
    PosCreditNoteMaster creditNotes = new();
    decimal decTendered = 0;
    decimal CashChange = 0;
    decimal customerBalance = 0;
    decimal excessAmount = 0;
    decimal remainingDebt = 0;

    //UserMaster? currentUser;
    CompanyView company = new();
    
    [Inject]
    private AccountLedgerService accountLedgerService { get; set; }
    protected override async Task OnInitializedAsync()
    {
        // تحميل رصيد العميل
        await LoadCustomerBalance();
        
        if (master.SalesMasterId == 0 && type == "Hold")
        {
            await SaveHoldBill();
        }
        else
        {
            //master.PayAmount = master.GrandTotal;
            decTendered = master.GrandTotal;
        }
        StateHasChanged();
    }
    
    private async Task LoadCustomerBalance()
    {
        try
        {
            var customers = await accountLedgerService.GetAllAccountLedgersByIdAsync(26);
            var customer = customers.FirstOrDefault(c => c.LedgerId == master.LedgerId);
            customerBalance = customer?.CurrentBalance ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في تحميل رصيد العميل: {ex.Message}");
            customerBalance = 0;
        }
    }
    private async void Save()
    {
        isProcessing = true;

        try
        {
            var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(master.VoucherTypeId);
            string strSerialNo = await salesInvoiceService.GetSerialNo();
            master.VoucherNo = $"{invoice.Suffix ?? string.Empty}-{strSerialNo}-{invoice.Prefix ?? string.Empty}";
            master.SerialNo = strSerialNo;
            // Check if at least one product is added
            if (!productList.Any())
            {
                Snackbar.Add("أضف منتج واحد على الأقل", Severity.Error);
                return;
            }
            // Check for zero quantity in any product
            foreach (var proItem in productList)
            {
                if (proItem.Qty == 0)
                {
                    Snackbar.Add("لا يمكن إنشاء معاملات بكمية صفر", Severity.Error);
                    return;
                }
            }
            // Validate master fields
            if (master.LedgerId == 0)
            {
                Snackbar.Add("اختر عميل صحيح.", Severity.Error);
                return;
            }
            if (master.GrandTotal == 0)
            {
                Snackbar.Add("الإجمالي الكلي لا يمكن أن يكون صفر.", Severity.Error);
                return;
            }
            if (master.WarehouseId == 0)
            {
                Snackbar.Add("اختر مستودع.", Severity.Error);
                return;
            }
            if (master.SalesMasterId == 0)
            {
                await SaveAsync();
            }
            else
            {
                await UpdateAsync();
            }
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task SaveAsync()
    {
        // Prepare product details
        foreach (var item in productList)
        {
            if (item.ProductId > 0)
            {
                var details = new SalesDetails
                    {
                        ProductId = item.ProductId,
                        Qty = item.Qty,
                        UnitId = item.UnitId,
                        Rate = item.SalesRate,
                        Discount = item.Discount,
                        DiscountAmount = item.DiscountAmount,
                        TaxId = item.TaxId == 0 ? 1 : item.TaxId,
                        TaxRate = item.TaxRate,
                        TaxAmount = item.TaxAmount,
                        BatchId = item.BatchId,
                        GrossAmount = item.GrossAmount,
                        NetAmount = item.NetAmount,
                        Amount = item.Amount,
                        OrderDetailsId = item.OrderDetailsId
                    };
                master.listOrder.Add(details);
            }
        }

        // Set transaction status


        // Save the transaction
        if (type == "Cash")
        {
            master.PaymentId = 1;
            master.Status = "Pending";
            master.PaymentStatus = "Cash";
            int result = await salesInvoiceService.SaveAsync(master);

            if (result > 0)
            {
                //SaveReceivePayment
                if (master.GrandTotal > 0)
                {
                    await SaveReceivePaymentAsync(result);
                }
                
                // خصم الزيادة من ديون العميل
                if (excessAmount > 0)
                {
                    await ApplyExcessToCustomerDebt(result);
                }
                
                // ربط المبيعة بسجل المبيعات المفتوح
                await LinkSaleToOpenRegister(result, 1); // 1 = Cash
                
                Snackbar.Add("تم إنشاء فاتورة المبيعات بنجاح.", Severity.Success);
                await OnButtonClick.InvokeAsync(result);
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
            }
        }
        else if (type == "Card")
        {
            master.PaymentId = 2;
            master.Status = "Pending";
            master.PaymentStatus = "Card";
            int result = await salesInvoiceService.SaveAsync(master);

            if (result > 0)
            {
                //SaveReceivePayment
                if (master.GrandTotal > 0)
                {
                    await SaveReceivePaymentAsync(result);
                }
                
                // خصم الزيادة من ديون العميل
                if (excessAmount > 0)
                {
                    await ApplyExcessToCustomerDebt(result);
                }
                
                // ربط المبيعة بسجل المبيعات المفتوح
                await LinkSaleToOpenRegister(result, 2); // 2 = Card
                
                Snackbar.Add("تم إنشاء فاتورة المبيعات بنجاح.", Severity.Success);
                await OnButtonClick.InvokeAsync(master.SalesMasterId);
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
            }
        }
        else if (type == "UPI")
        {
            master.PaymentId = 3;
            master.Status = "Pending";
            master.PaymentStatus = "UPI";
            int result = await salesInvoiceService.SaveAsync(master);

            if (result > 0)
            {
                //SaveReceivePayment
                if (master.GrandTotal > 0)
                {
                    await SaveReceivePaymentAsync(result);
                }
                
                // خصم الزيادة من ديون العميل
                if (excessAmount > 0)
                {
                    await ApplyExcessToCustomerDebt(result);
                }
                
                // ربط المبيعة بسجل المبيعات المفتوح
                await LinkSaleToOpenRegister(result, 3); // 3 = UPI
                
                Snackbar.Add("تم إنشاء فاتورة المبيعات بنجاح.", Severity.Success);
                await OnButtonClick.InvokeAsync(result);
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
            }
        }
        else if (type == "CreditSales")
        {
            master.Status = "Pending";
            master.PaymentStatus = "CreditSales";
            int result = await salesInvoiceService.SaveAsync(master);

            if (result > 0)
            {
                Snackbar.Add("تم إنشاء فاتورة المبيعات بنجاح.", Severity.Success);
                await OnButtonClick.InvokeAsync(result);
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
            }
        }
        else
        {

        }
    }
    private async Task UpdateAsync()
    {
        master.ModifyDate = DateTimeHelper.Now;

        // Prepare product details
        foreach (var item in productList)
        {
            if (item.ProductId > 0)
            {
                var details = new SalesDetails
                    {
                        SalesDetailsId = item.SalesDetailsId,
                        SalesMasterId = master.SalesMasterId,
                        ProductId = item.ProductId,
                        Qty = item.Qty,
                        UnitId = item.UnitId,
                        Rate = item.SalesRate,
                        Discount = item.Discount,
                        DiscountAmount = item.DiscountAmount,
                        TaxId = item.TaxId == 0 ? 1 : item.TaxId,
                        TaxRate = item.TaxRate,
                        TaxAmount = item.TaxAmount,
                        BatchId = item.BatchId,
                        GrossAmount = item.GrossAmount,
                        NetAmount = item.NetAmount,
                        Amount = item.Amount,
                        OrderDetailsId = item.OrderDetailsId
                    };
                master.listOrder.Add(details);
            }
        }
        foreach (var items in deleteNo)
        {
            DeleteItem details = new DeleteItem();
            if (items != null)
            {
                details.SalesDetailsId = items.SalesDetailsId;
                master.listDelete.Add(details);
            }

        }
        if ( master.PaymentStatus == "Hold" && type == "Cash")
        {
            var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(master.VoucherTypeId);
            string strSerialNo = await salesInvoiceService.GetSerialNo();
            master.VoucherNo = $"{invoice.Suffix ?? string.Empty}-{strSerialNo}-{invoice.Prefix ?? string.Empty}";
            master.SerialNo = strSerialNo;
            master.PaymentStatus = "Cash";
            bool isSave = await salesInvoiceService.UpdateHoldBillAsync(master);

            if (isSave == true)
            {
                Snackbar.Add("تم إنشاء الفاتورة المعلقة بنجاح.", Severity.Success);
                isProcessing = false;
                await OnButtonClick.InvokeAsync(master.SalesMasterId);
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
                isProcessing = false;
            }
        }
        else
        {
            if(type == "Cash")
            {
                master.PaymentId = 1;
            }
            else if(type == "Card")
            {
                master.PaymentId = 2;
            }
            else if(type == "UPI")
            {
                master.PaymentId = 3;                
            }
            // Update the transaction
            bool result = await salesInvoiceService.UpdateAsync(master);

            if (result == true)
            {
                Snackbar.Add("تم تحديث فاتورة المبيعات بنجاح.", Severity.Success);
                isProcessing = false;
            }
            else
            {
                Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
                isProcessing = false;
            }            
        }
    }
    private async Task SaveHoldBill()
    {
        isProcessing = true;

        try
        {
            var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(master.VoucherTypeId);
            string strSerialNo = await salesInvoiceService.GetSerialNo();
            master.VoucherNo = $"{invoice.Suffix ?? string.Empty}-{strSerialNo}-{invoice.Prefix ?? string.Empty}";
            master.SerialNo = strSerialNo;
            // Check if at least one product is added
            if (!productList.Any())
            {
                Snackbar.Add("أضف منتج واحد على الأقل", Severity.Error);
                return;
            }
            // Check for zero quantity in any product
            foreach (var proItem in productList)
            {
                if (proItem.Qty == 0)
                {
                    Snackbar.Add("لا يمكن إنشاء معاملات بكمية صفر", Severity.Error);
                    return;
                }
            }
            // Validate master fields
            if (master.LedgerId == 0)
            {
                Snackbar.Add("اختر عميل صحيح.", Severity.Error);
                return;
            }
            if (master.GrandTotal == 0)
            {
                Snackbar.Add("الإجمالي الكلي لا يمكن أن يكون صفر.", Severity.Error);
                return;
            }
            if (master.WarehouseId == 0)
            {
                Snackbar.Add("اختر مستودع.", Severity.Error);
                return;
            }
            if (master.SalesMasterId == 0)
            {
                // Proceed with saving if all validations pass
                master.TotalAmount = master.TotalAmount;
                master.TaxRate = 0;
                master.PayAmount = 0;

                master.PreviousDue = master.GrandTotal;
                master.BalanceDue = master.GrandTotal;
                master.FinancialYearId = company.FinancialYearId;
                master.VoucherTypeId = master.VoucherTypeId;
                if (master.IsPayment == true)
                {
                    master.IsPayment = true;
                }
                else
                {
                    master.IsPayment = false;
                    master.CashBankId = 0;
                    master.ReferenceReceipt = string.Empty;
                }

                // Prepare product details
                foreach (var item in productList)
                {
                    if (item.ProductId > 0)
                    {
                        var details = new SalesDetails
                            {
                                ProductId = item.ProductId,
                                Qty = item.Qty,
                                UnitId = item.UnitId,
                                Rate = item.SalesRate,
                                Discount = item.Discount,
                                DiscountAmount = item.DiscountAmount,
                                TaxId = item.TaxId == 0 ? 1 : item.TaxId,
                                TaxRate = item.TaxRate,
                                TaxAmount = item.TaxAmount,
                                BatchId = item.BatchId,
                                GrossAmount = item.GrossAmount,
                                NetAmount = item.NetAmount,
                                Amount = item.Amount,
                                OrderDetailsId = item.OrderDetailsId
                            };
                        master.listOrder.Add(details);
                    }
                }

                    master.SerialNo = "0";
                    master.VoucherNo = string.Empty;
                    master.PaymentId = 1;
                    master.Status = "Pending";
                    master.PaymentStatus = "Hold";
                    int result = await salesInvoiceService.SaveHoldBillAsync(master);

                    if (result > 0)
                    {
                        Snackbar.Add("تم إنشاء الفاتورة المعلقة بنجاح.", Severity.Success);
                        await OnButtonClick.InvokeAsync(result);
                    }
                    else
                    {
                        Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
                    }
            }
            else
            {

            }
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task SaveReceivePaymentAsync(int salesId)
    {
        // Initialize a new ReceiptMaster object
        ReceiptMaster paymentMaster = new ReceiptMaster();

        // Constants
        const int ReceivePaymentVoucherTypeId = 3; // Receive Voucher Type

        // Get the invoice settings and serial number
        var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(ReceivePaymentVoucherTypeId);
        string serialNo = await paymentinService.GetSerialNo();

        // Populate ReceiptMaster properties
        paymentMaster.Date = DateTimeHelper.Now;
        paymentMaster.VoucherNo = $"{invoice.Prefix}{serialNo}{invoice.Suffix}";
        paymentMaster.SerialNo = serialNo;
        paymentMaster.LedgerId = master.LedgerId; // Ensure `master` is properly defined in the context
        paymentMaster.VoucherTypeId = ReceivePaymentVoucherTypeId;
        paymentMaster.UserId = master.UserName; // Consider setting a meaningful user ID
        paymentMaster.FinancialYearId = company.FinancialYearId; // Ensure `company` is properly defined
        paymentMaster.SalesMasterId = salesId;
        paymentMaster.Narration = string.Empty;
        paymentMaster.Type = "CustomerPayment";
        paymentMaster.Status = "Paid";
        paymentMaster.PaidAmount = master.GrandTotal;
        paymentMaster.Amount = master.GrandTotal;
        paymentMaster.AddedDate = DateTimeHelper.Now;

        // Create a new ReceiptDetails instance and populate its properties
        ReceiptDetails details = new ReceiptDetails
            {
                LedgerId = 1, // Use a constant or parameter for maintainability if this value is reused
                SalesMasterId = salesId, // Link the ReceiptDetails to the given SalesMasterId
                TotalAmount = master.GrandTotal, // Assign the total grand amount from master
                ReceiveAmount = master.GrandTotal, // Assign the payment amount from master
                DueAmount = 0 // Assumes the due amount is fully paid; adjust logic if partial payments are possible
            };

        // Add the newly created ReceiptDetails instance to the listOrder collection
        paymentMaster.listOrder.Add(details);

        // Save the payment master record and handle the result
        int result = await paymentinService.SaveAsync(paymentMaster);

        // Optional: Add error handling or logging based on the result
        if (result <= 0)
        {
            // Log or handle failure case
            throw new Exception("فشل في حفظ معلومات الدفع.");
        }
    }
    private void CalculateTender()
    {
        try
        {
            var balance = decTendered - master.GrandTotal;
            
            if (balance >= 0)
            {
                // إذا كان المبلغ المدفوع أكبر من أو يساوي المطلوب
                CashChange = balance; // الباقي للإرجاع
                
                // حساب المبلغ الزائد الذي سيخصم من الديون
                if (balance > 0 && customerBalance > 0)
                {
                    excessAmount = Math.Min(balance, customerBalance);
                    remainingDebt = customerBalance - excessAmount;
                }
                else
                {
                    excessAmount = 0;
                    remainingDebt = customerBalance;
                }
            }
            else
            {
                // إذا كان المبلغ المدفوع أقل من المطلوب
                CashChange = Math.Abs(balance); // المبلغ المتبقي المطلوب
                excessAmount = 0;
                remainingDebt = customerBalance;
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في حساب المبلغ: {ex.Message}");
        }
    }
    private async Task CloseModal()
    {
        await OnButtonClick.InvokeAsync(0);
    }
    private void HandleChildButtonClick(string arg)
    {
        try
        {
            decTendered = Convert.ToDecimal(arg);
            CalculateTender(); // استخدام نفس دالة الحساب
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في تحويل القيمة من الآلة الحاسبة: {ex.Message}");
        }
    }

    private async Task ApplyExcessToCustomerDebt(int salesId)
    {
        try
        {
            Console.WriteLine($"=== خصم الزيادة من ديون العميل ===");
            Console.WriteLine($"المبلغ الزائد: {excessAmount}");
            Console.WriteLine($"رصيد العميل الحالي: {customerBalance}");
            
            if (excessAmount > 0 && customerBalance > 0)
            {
                // إنشاء سند دفع لخصم المبلغ من الديون
                ReceiptMaster debtPayment = new ReceiptMaster();
                
                const int ReceivePaymentVoucherTypeId = 3;
                var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(ReceivePaymentVoucherTypeId);
                string serialNo = await paymentinService.GetSerialNo();
                
                debtPayment.Date = DateTimeHelper.Now;
                debtPayment.VoucherNo = $"{invoice.Prefix}{serialNo}{invoice.Suffix}";
                debtPayment.SerialNo = serialNo;
                debtPayment.LedgerId = master.LedgerId;
                debtPayment.VoucherTypeId = ReceivePaymentVoucherTypeId;
                debtPayment.UserId = master.UserName;
                debtPayment.FinancialYearId = company.FinancialYearId;
                debtPayment.SalesMasterId = salesId;
                debtPayment.Narration = $"خصم من الديون - الزيادة من الفاتورة رقم {master.VoucherNo}";
                debtPayment.Type = "DebtPayment";
                debtPayment.Status = "Paid";
                debtPayment.PaidAmount = excessAmount;
                debtPayment.Amount = excessAmount;
                debtPayment.AddedDate = DateTimeHelper.Now;
                
                ReceiptDetails details = new ReceiptDetails
                {
                    LedgerId = 1,
                    SalesMasterId = 0, // ليس مرتبط بفاتورة محددة
                    TotalAmount = excessAmount,
                    ReceiveAmount = excessAmount,
                    DueAmount = 0
                };
                
                debtPayment.listOrder.Add(details);
                
                int result = await paymentinService.SaveAsync(debtPayment);
                
                if (result > 0)
                {
                    Console.WriteLine($"تم خصم {excessAmount} من ديون العميل بنجاح");
                    Snackbar.Add($"تم خصم {excessAmount:N2} ج.م من ديون العميل", Severity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في خصم الزيادة من الديون: {ex.Message}");
            Snackbar.Add("حدث خطأ في خصم الزيادة من الديون", Severity.Warning);
        }
    }
    
    private async Task LinkSaleToOpenRegister(int salesMasterId, int paymentMethodId)
    {
        try
        {
            Console.WriteLine($"=== ربط المبيعة {salesMasterId} بسجل المبيعات ===");
            
            // البحث عن سجل المبيعات المفتوح للمستخدم الحالي
            var openRegister = await _register.OpeningCashAsync(master.UserId);
            
            if (openRegister != null)
            {
                Console.WriteLine($"تم العثور على سجل مفتوح، ID: {openRegister.SalesRegisterId}");
                
                // إنشاء سجل ربط في SalesRegisterClosingBalance
                var closingBalance = new SalesRegisterClosingBalance
                {
                    SalesRegisterId = openRegister.SalesRegisterId,
                    PaymentMethodId = paymentMethodId,
                    Amount = master.GrandTotal,
                    SalesMasterId = salesMasterId,
                    VoucherTypeId = master.VoucherTypeId,
                    PayLater = 0,
                    CreditAppliedAmount = 0,
                    SalesReturnAmount = 0,
                    CashReturnAmount = 0,
                    ClosingAmount = 0,
                    ExpenseAmount = 0,
                    PurchasePayment = 0,
                    CashLeftinDrawer = 0,
                    PhysicalDrawer = 0,
                    AddedDate = DateTimeHelper.Now
                };
                
                // حفظ السجل باستخدام وظيفة جديدة في SalesRegisterService
                await _register.AddSaleToRegister(closingBalance);
                
                Console.WriteLine($"تم ربط المبيعة بسجل المبيعات بنجاح");
            }
            else
            {
                Console.WriteLine("لا يوجد سجل مبيعات مفتوح للمستخدم الحالي");
                // يمكن إنشاء سجل جديد تلقائياً هنا إذا لزم الأمر
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في ربط المبيعة بسجل المبيعات: {ex.Message}");
        }
    }
