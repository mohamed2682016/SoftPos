@inject SalesRegisterService salesRegisterService
@inject UserService userService
@inject NavigationManager NavigationManager
@inject CompanyService companyService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@using SoftPos.Utilities
<div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title d-flex align-items-center">
                    <i class="fa-solid fa-cash-register me-2"></i>
                    Cash Register Details @if (saleReg != null)
                    {
                        @saleReg.OpeningTime
                        <label>To</label>
                        @ToTime
                        ;
                    }
                </h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body">
                <div class="row g-3">
                    <!-- Left Column -->
                    <div class="col-md-8">
                        <table class="table table-bordered table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Opening Cash</td>
                                    <td>
                                        @if (saleReg != null)
                                        {
                                            @saleReg.OpeningCashAmount
                                        }
                                    </td>
                                </tr>
                                @if (listSalesRegister != null)
                                {
                                    @foreach (var item in listSalesRegister)
                                    {
                                        <tr>
                                            <td>@item.Name Payment</td>
                                            <td>@item.Amount</td>
                                        </tr>
                                    }
                                }
                                @if (listCloseReturn != null)
                                {
                                    @foreach (var item in listCloseReturn)
                                    {
                                        <tr>
                                            <td>Sales Return</td>
                                            <td>@item.SalesReturnAmount</td>
                                        </tr>
                                        <tr>
                                            <td>Cash Return</td>
                                            <td>@item.CashReturnAmount</td>
                                        </tr>
                                        <tr>
                                            <td>Pay Later</td>
                                            <td>@item.PayLater</td>
                                        </tr>
                                        <tr>
                                            <td>Credit Applied Amount</td>
                                            <td>@item.CreditAppliedAmount</td>
                                        </tr>
                                        <tr>
                                            <td>Expense</td>
                                            <td>@item.ExpenseAmount</td>
                                        </tr>
                                        <tr>
                                            <td>Purchase Payment</td>
                                            <td>@item.PurchasePayment</td>
                                        </tr>
                                        <tr>
                                            <td>Closing Amount</td>
                                            <td>@item.ClosingAmount</td>
                                        </tr>
                                    }
                                }
                                <tr class="table-info">
                                    <td>Total Sales</td>
                                    <td>
                                        @if (listSalesRegister != null)
                                        {
                                            @listSalesRegister.Sum(x => x.Amount)
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Right Column -->
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label for="cash-left" class="form-label">
                                <i class="fa-solid fa-money-bill-wave me-1"></i> Total Cash Left in Drawer
                            </label>
                            <input id="cash-left" type="number" class="form-control" @bind="register.CashLeftinDrawer" readonly>
                        </div>
                        <div class="form-group mb-3">
                            <label for="physical-drawer" class="form-label">
                                <i class="fa-solid fa-drawer me-1"></i> Physical Drawer
                            </label>
                            <input id="physical-drawer" type="number" class="form-control"
                            @bind="register.PhysicalDrawer" @oninput="CalculateDrawer">
                            <small class="text-muted d-block">Short: @decShortAmount</small>
                        </div>
                        <div class="form-group mb-3">
                            <label for="closing-note" class="form-label">
                                <i class="fa-solid fa-note-sticky me-1"></i> Closing Note
                            </label>
                            <textarea id="closing-note" class="form-control" rows="3" @bind="register.Notes"></textarea>
                        </div>
                    </div>
                </div>
                <!-- Buttons -->
                <div class="row mt-3">
                    <div class="col-md-4 offset-md-4 text-center">
                        <button type="button" class="btn btn-primary w-100" @onclick="CloseBalance">
                            <i class="fa-solid fa-lock me-1"></i> Close Register
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    IList<SalesRegisterClosingBalanceView> listSalesRegister;
    IList<SalesRegisterClosingBalanceView> listCloseReturn;
    decimal decShortAmount = 0;
    SalesRegister register = new();
    SalesRegister saleReg = new();
    DateTime ToTime;
    UserMaster? currentUser;
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            currentUser = await userService.GetCurrentUser();
            
            if (currentUser == null)
            {
                Snackbar.Add("خطأ: لم يتم العثور على المستخدم الحالي", Severity.Error);
                return;
            }

            ToTime = DateTimeHelper.Now;
            
            // Load sales register data
            listSalesRegister = await salesRegisterService.CashRegisterAsync(currentUser.UserId);
            if (listSalesRegister == null)
            {
                listSalesRegister = new List<SalesRegisterClosingBalanceView>();
            }

            // Load closing return data
            listCloseReturn = await salesRegisterService.CloseReturnAsync(currentUser.UserId);
            if (listCloseReturn == null)
            {
                listCloseReturn = new List<SalesRegisterClosingBalanceView>();
            }

            // Load opening cash data
            saleReg = await salesRegisterService.OpeningCashAsync(currentUser.UserId);
            
            if (saleReg == null)
            {
                Snackbar.Add("تحذير: لا يوجد سجل مفتوح للمستخدم الحالي", Severity.Warning);
                
                // Initialize with default values
                register.CashLeftinDrawer = 0;
                register.PhysicalDrawer = 0;
                return;
            }

            // Calculate total cash
            decimal decTotalCash = listSalesRegister.Sum(x => x.Amount);
            register.CashLeftinDrawer = Math.Round(decTotalCash + saleReg.OpeningCashAmount, 2);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }
    void CalculateDrawer()
    {
        decShortAmount = register.CashLeftinDrawer > register.PhysicalDrawer ? Math.Round(register.CashLeftinDrawer - register.PhysicalDrawer, 2) : 0;
        StateHasChanged();
    }

    async Task CloseBalance()
    {
        try
        {
            // Validate input
            if (currentUser == null)
            {
                Snackbar.Add("خطأ: لم يتم العثور على المستخدم الحالي", Severity.Error);
                return;
            }

            if (register.PhysicalDrawer < 0)
            {
                Snackbar.Add("خطأ: لا يمكن أن يكون المبلغ الفعلي في الدرج سالباً", Severity.Error);
                return;
            }

            // Check if there's an open register first
            var openRegister = await salesRegisterService.OpeningCashAsync(currentUser.UserId);
            if (openRegister == null)
            {
                // Create a new register if none exists
                var newRegister = new SalesRegister
                {
                    UserId = currentUser.UserId,
                    OpeningTime = DateTimeHelper.Now.AddHours(-1), // Set opening time to 1 hour ago
                    OpeningCashAmount = 0,
                    Status = "Open",
                    Notes = "تم إنشاؤه تلقائياً عند الإغلاق",
                    AddedDate = DateTimeHelper.Now
                };
                
                await salesRegisterService.SaveAsync(newRegister);
            }

            // Set register properties
            register.UserId = currentUser.UserId;
            // Calculate total cash in drawer (opening cash + sales)
            decimal totalSales = listSalesRegister?.Sum(x => x.Amount) ?? 0;
            decimal openingCash = saleReg?.OpeningCashAmount ?? 0;
            register.ClosingCashAmount = totalSales + openingCash;
            register.ClosingTime = DateTimeHelper.Now;
            register.ModifyDate = DateTimeHelper.Now;
            register.ReturnAmount = 0;
            register.Status = "Close";

            // Attempt to close the register
            bool result = await salesRegisterService.CloseBalanceAsync(register);
            
            if (result)
            {
                Snackbar.Add("تم إغلاق السجل بنجاح", Severity.Success);
                await Task.Delay(1000); // Give user time to see the success message
                NavigationManager.NavigateTo("/dashboard");
            }
            else
            {
                Snackbar.Add("فشل في إغلاق السجل", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ غير متوقع: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }

    private async Task CloseModal()
    {
        NavigationManager.NavigateTo("/dashboard");
    }
}
