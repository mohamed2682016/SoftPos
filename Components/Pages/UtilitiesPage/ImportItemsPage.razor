@page "/import-items"
@using SoftPos.Resources
@inject NavigationManager NavigationManager
@inject ExcelImportService ExcelImportService
@inject ItemPartiesExportService itemexportService

<div class="container mt-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4 class="text-primary">@CommonTranslations.Import @PageTranslations.NavigationTranslations.Items</h4>
            <p class="text-muted">استيراد بيانات الأصناف من ملف Excel</p>
        </div>
    </div>

    <!-- Card Section -->
    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Import Buttons -->
            <div class="row mb-3 text-center">
                <div class="col-12 col-md-6 mb-3">
                    <button class="btn btn-primary" @onclick="DownloadFile">@CommonTranslations.Download نموذج</button>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <div class="mb-3">
                        <label for="fileInput" class="form-label">اختر ملف Excel</label>
                        <InputFile OnChange="@HandleFileChange" class="form-control" accept=".xlsx" />
                    </div>

                    <button @onclick="ImportData" class="btn btn-primary" disabled="@(!isFileSelected || isSaving)">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>جاري الحفظ...</span>
                                    }
                        else
                        {
                            <span>@CommonTranslations.Import البيانات</span>
                         }
                    </button>

                </div>
            </div>
            <!-- Instruction Section -->
            <div class="row">
                <div class="col text-center">
                    <p class="text-muted">
                    <p class="mt-3">@statusMessage</p>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedFilePath;
    private bool isFileSelected = false;
    private bool isSaving = false; // Flag to track saving state
    private string statusMessage = string.Empty;

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0) // Check if a file is selected
        {
            var file = e.File; // Get the first file
            selectedFilePath = Path.Combine(FileSystem.AppDataDirectory, file.Name);

            // Save uploaded file locally
            using var fileStream = new FileStream(selectedFilePath, FileMode.Create);
            await file.OpenReadStream().CopyToAsync(fileStream);

            isFileSelected = true;
            statusMessage = "تم اختيار الملف. جاهز للاستيراد.";
        }
        else
        {
            statusMessage = "لم يتم اختيار ملف.";
        }
    }
    private void DownloadFile()
    {
        // Navigate to the file's URL
        NavigationManager.NavigateTo("downloaddemo/item.xlsx", forceLoad: true);
    }

    private async Task ImportData()
    {
        isSaving = true; // Set saving flag
        statusMessage = "جاري استيراد البيانات...";

        try
        {
            // Read data from Excel
            var products = await ExcelImportService.ReadProductsFromExcelAsync(selectedFilePath);

            // Save data into SQLite
            bool isSave = await itemexportService.SaveProducts(products);

            if (isSave)
            {
                statusMessage = $"تم استيراد {products.Count} منتج بنجاح!";
                isFileSelected = false; // Disable the button after saving
            }
            else
            {
                statusMessage = "خطأ في حفظ البيانات. يرجى المحاولة مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false; // Reset saving flag
        }
    }
}
