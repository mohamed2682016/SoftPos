@page "/sales/register/arabic"
@inject UserService userService
@inject SalesRegisterService salesregisterService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@using SoftPos.Data.InventoryModel

@using SoftPos.Utilities
<div class="container mt-4" dir="rtl">
    <!-- Header Section -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4 class="text-primary fw-bold">سجل المبيعات</h4>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <!-- From Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                <label class="form-label fw-semibold">من تاريخ</label>
                                <InputDate class="form-control" @bind-Value="FromDate" />
                            </div>
                        </div>

                        <!-- To Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                <label class="form-label fw-semibold">إلى تاريخ</label>
                                <InputDate class="form-control" @bind-Value="ToDate" />
                            </div>
                        </div>

                        <!-- Cashier Dropdown -->
                        <div class="col-lg-4 col-sm-6 col-12">
                            <div class="form-group">
                                <label class="form-label fw-semibold">أمين الصندوق</label>
                                <select class="form-control" @bind="intUserId">
                                    <option value="0">جميع المستخدمين</option>
                                    @if (listUsers != null)
                                    {
                                        @foreach (var item in listUsers)
                                        {
                                            <option value="@item.UserId">@item.Email</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Search Button -->
                        <div class="col-lg-2 col-sm-6 col-12 align-self-end">
                            <button class="btn btn-primary w-100" @onclick="Filtter">
                                <i class="fas fa-search me-2"></i> بحث
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="table-responsive mt-4">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th scope="col">أمين الصندوق</th>
                                <th scope="col">من تاريخ</th>
                                <th scope="col">إلى تاريخ</th>
                                <th scope="col">الحالة</th>
                                <th scope="col">النقد في اليد</th>
                                <th scope="col">نقد</th>
                                <th scope="col">بطاقة</th>
                                <th scope="col">محفظة</th>
                                <th scope="col">دفع لاحق</th>
                                <th scope="col">إجمالي المبيعات</th>
                                <th scope="col">مبلغ الائتمان المطبق</th>
                                <th scope="col">مبلغ مرتجعات المبيعات</th>
                                <th scope="col">مبلغ الإغلاق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listSalesRegister == null || !listSalesRegister.Any())
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted py-4">
                                        <div>
                                            <i class="fas fa-exclamation-circle fs-1 text-warning"></i>
                                            <h5 class="mt-2">لا توجد بيانات</h5>
                                            <p class="mb-2">لا توجد سجلات مبيعات في النطاق الزمني المحدد</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in listSalesRegister)
                                {
                                    <tr>
                                        <td>@item.FullName</td>
                                        <td>@(item.OpeningTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                        <td>@(item.ClosingTime?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                        <td>
                                            <span class="badge @(GetStatusBadgeClass(item.Status))">
                                                @GetStatusText(item.Status)
                                            </span>
                                        </td>
                                        <td>@item.OpeningCashAmount.ToString("F2")</td>
                                        <td>@item.Cash.ToString("F2")</td>
                                        <td>@item.Card.ToString("F2")</td>
                                        <td>@item.UPI.ToString("F2")</td>
                                        <td>@item.PayLater.ToString("F2")</td>
                                        <td><strong>@item.TotalSales.ToString("F2")</strong></td>
                                        <td>@item.CreditAppliedAmount.ToString("F2")</td>
                                        <td>@item.SalesReturnAmount.ToString("F2")</td>
                                        <td><strong>@item.ClosingAmount.ToString("F2")</strong></td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            @if (listSalesRegister != null && listSalesRegister.Any())
                            {
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">الإجمالي</td>
                                    <td>@listSalesRegister.Sum(x => x.OpeningCashAmount).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.Cash).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.Card).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.UPI).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.PayLater).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.TotalSales).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.CreditAppliedAmount).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.SalesReturnAmount).ToString("F2")</td>
                                    <td>@listSalesRegister.Sum(x => x.ClosingAmount).ToString("F2")</td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    List<UserMaster> listUsers = new();
    List<SalesRegisterClosingBalanceView> listSalesRegister = new();
    DateTime FromDate = DateTimeHelper.Now.AddDays(-7); // أسبوع ماضي
    DateTime ToDate = DateTimeHelper.Now.AddDays(1);   // غداً
    int intUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        await Filtter();
    }

    private async Task Filtter()
    {
        try
        {
            listUsers = await userService.GetAllUserMastersAsync();
            listSalesRegister = await salesregisterService.GetAll(intUserId, FromDate, ToDate);
            StateHasChanged();
        }
        catch (Exception)
        {
            Snackbar.Add("خطأ في تحميل البيانات", Severity.Error);
        }
    }

    private string GetStatusText(string status)
    {
        return status?.ToLower() switch
        {
            "open" => "مفتوح",
            "close" => "مغلق",
            "closed" => "مغلق",
            _ => status ?? "غير محدد"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "open" => "bg-success",
            "close" => "bg-secondary",
            "closed" => "bg-secondary",
            _ => "bg-warning"
        };
    }
}