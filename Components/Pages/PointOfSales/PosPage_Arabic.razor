                .Take(16)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في اختيار المنتج: {ex.Message}");
            Snackbar.Add($"خطأ في اختيار المنتج: {ex.Message}", Severity.Error);
