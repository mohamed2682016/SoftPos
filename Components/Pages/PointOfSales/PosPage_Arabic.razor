@page "/pos-ar"
@inject SalesRegisterService _register
@inject PaymentInService paymentinService
@inject BrandService brandService
@inject SalesInvoiceService salesInvoiceService
@inject CategoryService categoryService
@inject InvoiceSettingService invoiceSettingService
@inject UserService userService
@inject CompanyService companyService
@inject TaxService taxService
@inject AccountLedgerService accountledgerService
@inject WarehouseService warehouseService
@inject UnitService unitService
@inject ProductService productService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using SoftPos.Components.Layout
@using SoftPos.Resources
@using SoftPos.Utilities
@layout PosLayout
<div class="container-fluid custom-container" dir="rtl">
    <!-- Header Section -->
    <div class="pos-header d-flex flex-column flex-md-row justify-content-between align-items-center">
        <PosHeaderNav master="@master" WarehouseList="@listWarehouse" />
    </div>

    <!-- Main Section -->
    <div class="row mt-3 main-section">
        <!-- Products Section - الآن في الجانب الأيسر -->
        <div class="col-md-5 left-panel">
            <div class="card cart-card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <!-- Category Dropdown -->
                    <div class="customer-select w-100">
                        <label for="categoryDropdown" class="visually-hidden">اختر الفئة</label>
                        <select id="categoryDropdown" class="form-select w-100" @bind="selectedCategoryId" @onclick="() => LoadProducts(selectedCategoryId)">
                            <option value="0">جميع الفئات</option>
                            @if (listCategory != null)
                            {
                                foreach (var item in listCategory)
                                {
                                    <option value="@item.GroupId">@item.GroupName</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Brand Dropdown -->
                    <div class="warehouse-select w-100">
                        <label for="brandDropdown" class="visually-hidden">اختر الماركة</label>
                        <select id="brandDropdown" class="form-select w-100" @bind="@selectedBrandId">
                            <option value="0">جميع الماركات</option>
                            @if (listBrand != null)
                            {
                                foreach (var brand in listBrand)
                                {
                                    <option value="@brand.BrandId">@brand.Name</option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <div class="card-body p-3">
                    <!-- Items Cards -->
                    <div class="items-container">
                        @if (listProduct != null)
                        {
                            @foreach (var product in listProduct)
                            {
                                <div class="item-card">
                                    <a @onclick="()=>ChangeProduct(product.ProductName)" style="cursor:pointer;">
                                        @if (string.IsNullOrEmpty(product.Image))
                                        {
                                            <img src="/img/noimage.png" class="item-image" />
                                        }
                                        else
                                        {
                                            <img src="@product.Image" class="item-image" />
                                        }
                                        <div class="card-body text-center">
                                            <h5 class="item-title mt-2">@product.ProductName</h5>
                                            <div class="product-info mt-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="badge bg-info text-white">
                                                        <i class="fas fa-boxes"></i> @product.CurrentStock
                                                    </span>
                                                    <span class="badge bg-success text-white">
                                                        <i class="fas fa-tag"></i> @company?.CurrencySymbol@product.SalesRate
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>





            <!-- أزرار العمليات -->
            <div class="payment-buttons-footer bg-white py-2 shadow-sm mt-3">
                <div class="d-flex justify-content-center gap-1 quick-payment-buttons flex-wrap">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="HoldBill">
                        <i class="fas fa-clock me-1"></i> فواتير مؤجلة
                    </button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="LoadData">
                        <i class="fas fa-trash-alt me-1"></i> مسح السلة
                    </button>
                    <button class="btn btn-outline-info btn-sm" @onclick="RegisterDetails">
                        <i class="fas fa-info-circle me-1"></i> تفاصيل السجل
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RecentTransaction">
                        <i class="fas fa-history me-1"></i> المعاملات الأخيرة
                    </button>
                    @if (id > 0 || master.SalesMasterId > 0)
                    {
                        <button class="btn btn-outline-success btn-sm" @onclick="ShowPrintModal">
                            <i class="fas fa-print me-1"></i> طباعة آخر فاتورة
                        </button>
                    }
                </div>
            </div>



            <!-- الإجماليات وتفاصيل الدفع - في الجانب الأيمن -->
                    <div class="container-fluid bg-light border rounded py-2 mt-2">
                        <div class="row text-center g-1">
                            <!-- Quantity -->
                            <div class="col-6 col-md-3 border-end">
                                <h6 class="fw-bold text-dark mb-0">@productList?.Sum(c => c.Qty)</h6>
                                <small class="text-secondary">الكمية</small>
                            </div>

                            <!-- Taxable Amount -->
                            <div class="col-6 col-md-3 border-end">
                                <h6 class="fw-bold text-success mb-0">@(master?.NetAmounts)</h6>
                                <small class="text-secondary">الخاضع للضريبة</small>
                            </div>

                            <!-- Tax Amount -->
                            <div class="col-6 col-md-2 border-end">
                                <h6 class="fw-bold text-warning mb-0">@(master?.TotalTax ?? 0)</h6>
                                <small class="text-secondary">الضريبة</small>
                            </div>

                            <!-- Discount -->
                            <div class="col-6 col-md-2 border-end">
                                <h6 class="fw-bold text-danger mb-0">@master.BillDiscount</h6>
                                <small class="text-secondary">الخصم</small>
                            </div>

                            <!-- Total Amount -->
                            <div class="col-12 col-md-2">
                                <h6 class="fw-bold text-primary mb-0">@master.GrandTotal</h6>
                                <small class="text-secondary">الإجمالي</small>
                            </div>
                        </div>
                    </div>




        </div>

        <!-- Cart Section - الآن في الجانب الأيمن -->
        <div class="col-md-7 right-panel">
            <div class="row">
                <div class="col-md-12 items-section">
                    <div class="row g-3">
                        <!-- Customer Selection -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-user"></i>
                                    </span>
                                    <select class="form-select" aria-label="اختر العميل" @bind="master.LedgerId" @bind:after="OnCustomerChanged">
                                        @foreach (var supplier in listLedger ?? new List<AccountLedgerView>())
                                        {
                                            <option value="@supplier.LedgerId">@supplier.LedgerName</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-light add_new_customer" @onclick="ShowModal">
                                        <i class="fa fa-plus-circle text-primary"></i>
                                    </button>
                                </div>
                                @if (selectedCustomerBalance > 0)
                                {
                                    <div class="alert alert-warning mt-2 mb-0 py-1 px-2 d-flex align-items-center" style="font-size: 0.9rem;">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <span><strong>رصيد العميل:</strong> @company?.CurrencySymbol @selectedCustomerBalance.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Product Search -->
                        <div class="col-md-8">
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="d-flex align-items-center gap-2 autocomplete-container">
                                        <!-- Autocomplete Input and List -->
                                        <div class="autocomplete position-relative flex-grow-1">
                                            @* Razor block to handle empty state variable *@
                                            @{
                                                var strEmpty = string.Empty;
                                            }

                                            <input @bind="@strBarcode"
                                            class="form-control shadow-sm"
                                            onclick="getfocus()"
                                            @onchange="() => OnChange()"
                                            @onkeyup="() => OnChange()"
                                            @bind:event="oninput"
                                            placeholder="مسح أو البحث عن منتج" style="width:540px;">

                                            @if (listAutocomplete != null)
                                            {
                                                @if (!string.IsNullOrEmpty(strBarcode))
                                                {
                                                    <ul class="options list-group shadow-lg">
                                                        @if (listAutocomplete.Any())
                                                        {
                                                            @foreach (var itemProduct in listAutocomplete)
                                                            {
                                                                <li id="focus"
                                                                class="option list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                                @onclick="() => OnChangeBarcode(itemProduct.ProductName)">
                                                                    <span class="option-text fw-bold">@itemProduct.ProductName</span>
                                                                    <span class="badge bg-primary">@itemProduct.CurrentStock</span>
                                                                </li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li class="option list-group-item disabled text-center">
                                                                <em>لا توجد نتائج</em>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            }
                                        </div>

                                        <!-- Add Product Button -->
                                        <button type="button" class="btn btn-light shadow-sm pos_add_quick_product" @onclick="ShowModalProduct">
                                            <i class="fa fa-plus-circle text-primary"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    @* CartHere *@
                    <!-- Cart Items Table -->
                    <div class="cart-container" style="max-height: 510px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px;">

                        <table class="table table-striped table-hover table-sm align-middle" style="margin-top: 10px;">
                            <thead class="table-dark">
                                <tr>
                                    <th style="max-width: 280px;">الصنف</th>
                                    <th style="max-width: 100px;" class="text-center">الكمية</th>
                                    <th style="max-width: 140px;" class="text-center">السعر</th>
                                    <th style="max-width: 120px;" class="text-center">نسبة الخصم</th>
                                    <th style="max-width: 120px;" class="text-end">المجموع</th>
                                    <th class="text-center">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (productList.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <img src="img/noimage.png" alt="لا توجد أصناف في السلة" class="img-fluid rounded-circle" style="max-width: 80px;">
                                            <p class="text-muted mt-2">لا توجد أصناف في السلة</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in productList)
                                    {
                                        <tr>
                                            <td style="max-width: 280px;">
                                                <div class="d-flex align-items-center">
                                                    <span class="fw-bold me-auto">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-danger" @onclick="()=>Decrease(item.ProductId)">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <input type="text" class="form-control text-center border-dark rounded" style="max-width: 100px;"
                                                           @bind-value="item.Qty"
                                                           @onkeyup="@(e => editItem(item.ProductId))"
                                                           @onchange="@(e => editItem(item.ProductId))"
                                                           @bind-value:event="oninput">
                                                    <button class="btn btn-outline-success" @onclick="()=>Increase(item.ProductId)">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <input type="number" class="form-control form-control-sm rounded" style="max-width: 140px;"
                                                       @bind-value="item.SalesRate"
                                                       @onkeyup="@(e => editItem(item.ProductId))"
                                                       @onchange="@(e => editItem(item.ProductId))"
                                                       @bind-value:event="oninput">
                                            </td>
                                            <td class="text-center">
                                                <input type="number" class="form-control form-control-sm rounded" style="max-width: 120px;"
                                                       @bind-value="item.Discount"
                                                       @onkeyup="@(e => editItem(item.ProductId))"
                                                       @onchange="@(e => editItem(item.ProductId))"
                                                       @bind-value:event="oninput">
                                            </td>
                                            <td class="text-end fw-bold" style="max-width: 160px;">
                                                @company?.CurrencySymbol @item.Amount
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-danger btn-sm rounded-circle" @onclick="()=>DeleteItem(item.ProductId)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>

                

                    <!-- Payment Section - في الجانب الأيمن -->
                    @if (master.GrandTotal > 0 && productList.Any())
                    {
                        <div class="card mt-2 shadow-sm payment-section">
                            <div class="card-header bg-primary text-white py-2">
                                <h6 class="mb-0 fs-6">
                                    <i class="fas fa-credit-card me-2"></i>
                                    <span>تفاصيل الدفع</span>
                                </h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row g-2">
                                    <!-- Payment Fields in One Row -->
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-secondary">🔄 طريقة الدفع</label>
                                        <select class="form-select payment-method-select" @bind="selectedPaymentMethod">
                                            <option value="Cash" selected>💵 نقدي</option>
                                            <option value="Card">💳 بطاقة</option>
                                            <option value="UPI">📱 محفظة</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-primary">💰 المبلغ المستحق</label>
                                        <div class="total-amount-display">
                                            <input type="text" value="@($"{company?.CurrencySymbol}{master.GrandTotal}")" 
                                                   class="form-control text-end fw-bold total-amount-input" readonly>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-info">💳 المبلغ المدفوع</label>
                                        <input type="number" @bind="paidAmount" @bind:event="oninput" @onkeyup="CalculateChange" @onchange="CalculateChange" 
                                               class="form-control text-end payment-amount-input" placeholder="أدخل المبلغ المدفوع"
                                               disabled="@IsShopCustomer()">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small">
                                            @if (changeAmount >= 0)
                                            {
                                                <span class="text-success">💚 الباقي للإرجاع</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">❗ المبلغ المتبقي</span>
                                            }
                                        </label>
                                        <input type="text" value="@($"{company?.CurrencySymbol}{Math.Abs(changeAmount)}")" 
                                               class="form-control text-end fw-bold @(changeAmount >= 0 ? "change-amount-positive" : "change-amount-negative")" readonly>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="col-12">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearPayment">
                                                <i class="fas fa-times me-1"></i> إلغاء
                                            </button>
                                            <button type="button" class="btn btn-success btn-sm px-3 payment-button @(isProcessingPayment ? "payment-processing" : "")" @onclick="ProcessPayment" disabled="@(isProcessingPayment)">
                                                @if (isProcessingPayment)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                    <span>جاري المعالجة...</span>
                                                }
                                                else
                                                {
                                                    @if (selectedPaymentMethod == "Cash")
                                                    {
                                                        <i class="fas fa-money-bill-wave me-2"></i>
                                                        <span>دفع نقدي</span>
                                                    }
                                                    else if (selectedPaymentMethod == "Card")
                                                    {
                                                        <i class="fas fa-credit-card me-2"></i>
                                                        <span>دفع بالبطاقة</span>
                                                    }
                                                    else if (selectedPaymentMethod == "UPI")
                                                    {
                                                        <i class="fas fa-mobile-alt me-2"></i>
                                                        <span>دفع محفظة</span>
                                                    }
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>
</div>

@if (IsModalVisible)
{
    <SoftPos.Components.Pages.ComponentsSetting.CustomerPopup OnButtonClick="CustomerButtonClick" />
}

@if (IsModalVisibleProduct)
{
    <SoftPos.Components.Pages.ComponentsSetting.ProductPopup OnButtonClick="ProductButtonClick" />
}
@if (IsModalVisibleCoupon)
{
    <SoftPos.Components.Pages.ComponentsSetting.CouponPopUp OnButtonClick="CouponButtonClick" />
}
@if (IsModalVisibleCashinHand)
{
    <SoftPos.Components.Pages.ComponentsSetting.CashinHandPopUp OnButtonClick="CashInHandButtonClick" />
}

@if (IsModalVisibleHoldBill)
{
    <SoftPos.Components.Pages.ComponentsSetting.HoldBillPopUp OnButtonClick="HoldBillButtonClick" />
}
@if (IsModalVisibleRecentTransaction)
{
    <SoftPos.Components.Pages.ComponentsSetting.RecentTransactionPopUp OnButtonClick="RecentTransactionButtonClick" />
}
@if (IsModalVisibleSalesRegister)
{
    <SoftPos.Components.Pages.ComponentsSetting.SalesRegisterPopUp_Arabic />
}
@if (IsModalVisiblePrint)
{
    <SoftPos.Components.Pages.ComponentsSetting.PrintThermalPrint id="master.SalesMasterId" OnButtonClick="PrintButtonClick" />
}
@code
{
    private int id { get; set; }
    string strHoldBill = "Hold";
    string strCash = "Cash";
    string strCard = "Card";
    string strUPI = "UPI";
    string strCreditSales = "CreditSales";
    private DateTime currentDateTime = DateTimeHelper.Now; // توقيت القاهرة
    private SalesMaster master = new SalesMaster();
    List<Brand> listBrand;
    List<ProductGroupView> listCategory;
    List<AccountLedgerView> listLedger;
    List<Warehouse> listWarehouse;
    List<ProductView> listProduct;
    List<ProductView> listProductAll;
    List<ProductView> listProductAllCategory;
    List<Tax> listTax;
    ProductView product = new ProductView();
    ProductView viewProduct = new ProductView();
    List<ProductView> productList = new List<ProductView>();
    private int selectedBrandId = 0;
    private int selectedCategoryId = 0; // Tracks the currently selected category
                                        //HoldDeleteItem
    List<DeleteItem> deleteNo = new List<DeleteItem>();
    string type;
    string strBarcode = string.Empty;
    List<ProductView> listAutocomplete;
    private CompanyView company;
    int voucherTypeId = 12; // Sales Invoice Voucher Type
    SalesRegister register = new();
    private bool IsModalVisibleCashinHand = false;
    private bool IsModalVisible = false;
    private bool IsModalVisibleProduct = false;
    private bool IsModalVisibleCoupon = false;
    private bool IsModalVisiblePrint = false;
    private bool IsModalVisibleCashPayment = false;
    private bool IsModalVisibleHoldBill = false;
    private bool IsModalVisibleRecentTransaction = false;
    private bool IsModalVisibleSalesRegister = false;
    public int min { get; set; } = 0;
    public int max { get; set; } = 100000;
    UserMaster? currentUser;
    
    // Payment variables
    private string selectedPaymentMethod = "Cash";
    private decimal paidAmount = 0;
    private decimal changeAmount = 0;
    private bool isProcessingPayment = false;
    
    // Customer balance tracking
    private decimal selectedCustomerBalance = 0;
    
    // دالة للتحقق من العميل ذو الكود 5 (عميل المحل)
    private bool IsShopCustomer()
    {
        var selectedCustomer = listLedger?.FirstOrDefault(c => c.LedgerId == master.LedgerId);
        return selectedCustomer?.LedgerCode == "5";
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        // تم إلغاء ميزة حفظ السلة في localStorage
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // تأكد من تحديد العميل الأول بعد الـ render
            if (listLedger != null && listLedger.Any() && master.LedgerId == 0)
            {
                master.LedgerId = listLedger.First().LedgerId;
                StateHasChanged();
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }
    
    private async Task LoadData()
    {
        try
        {
            currentUser = await userService.GetCurrentUser(); // Fetch the current user
            master.UserId = currentUser.UserId;
            master.UserName = currentUser.Username;
            await ShowCashinhand();
            company = await companyService.GetAllCompaniesByIdAsync(1);
            listCategory = await categoryService.GetAllProductGroupsAsync();
            listLedger = await accountledgerService.GetAllAccountLedgersByIdAsync(26);
            
            listTax = await taxService.GetAllTaxsAsync();
            listWarehouse = await warehouseService.GetAllWarehousesAsync();
            listProduct = await productService.GetAllProductsAsync();
            listProductAll = listProduct;
            listProductAllCategory = listProduct;
            listBrand = await brandService.GetAllBrandsAsync();
            master.SalesMasterId = 0;
            master.VoucherTypeId = voucherTypeId;
            
            // تعيين أول عميل من القائمة كافتراضي - بدون أي شروط خاصة
            if (listLedger != null && listLedger.Any())
            {
                master.LedgerId = listLedger.First().LedgerId;
                StateHasChanged(); // تحديث الواجهة لعرض العميل المحدد
            }
            else
            {
                master.LedgerId = 0;
            }
            
            master.WarehouseId = company.WarehouseId;
            
            // استخدام توقيت القاهرة
            master.Date = DateTimeHelper.Now;
            master.DueDate = DateTimeHelper.Now;
            viewProduct.TaxId = 1;
            master.TaxId = 1;
            master.Narration = string.Empty;
            master.Reference = string.Empty;
            master.CouponAmount = 0;
            master.ReferenceReceipt = string.Empty;
            master.NetAmounts = 0;
            master.TotalTax = 0;
            master.GrandTotal = 0;
            master.IsPayment = false;
            master.PaymentId = 1;
            master.OrderMasterId = 0;
            master.Channel = "POS";

            productList.Clear();
            
            // Reset payment values
            paidAmount = 0;
            changeAmount = 0;
            selectedPaymentMethod = "Cash";
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }
    
    // تم إزالة جميع دوال localStorage (SaveCart, RestoreCart, ClearSavedCart)
    //CashInHand
    async Task ShowCashinhand()
    {
        if (currentUser != null)
        {
            register.UserId = currentUser.UserId;
            register.OpeningCashAmount = 0;
            register.ClosingCashAmount = 0;
            register.OpeningTime = DateTimeHelper.Now;
            register.ReturnAmount = 0;
            register.Notes = string.Empty;
            register.Status = "Open";
            var result = await _register.CheckNameId(register);
            if (result == false)
            {
                IsModalVisibleCashinHand = true;
            }
            StateHasChanged();
        }
    }
    private async void AddFirstRow()
    {
        var myItem = new ProductView()
            {
                Id = productList.Count() + 1,
                Qty = 0,
                ProductId = 0,
                TaxId = 0,
                UnitId = 0,
                BatchId = 0,
                Discount = 0,
                TaxRate = 0,
                GrossAmount = 0,
                DiscountAmount = 0,
                NetAmount = 0,
