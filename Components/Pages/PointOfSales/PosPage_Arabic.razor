            CalculateTotal();
            strBarcode = string.Empty;
            listAutocomplete = null;
            StateHasChanged();
        }
    }

    private async Task OnChange()
    {
        var strStatus = "Warn";
        
        try
        {
            if (string.IsNullOrWhiteSpace(strBarcode))
            {
                listAutocomplete = null;
                return;
            }
            
            // البحث بالباركود - مطابقة تامة فقط للإضافة التلقائية
            product = listProduct.FirstOrDefault(x => !string.IsNullOrEmpty(x.Barcode) && x.Barcode.Equals(strBarcode, StringComparison.OrdinalIgnoreCase));
            
            // إذا لم نجد بالباركود، نبحث بكود المنتج (ProductCode)
            if (product == null)
            {
                product = listProduct.FirstOrDefault(x => !string.IsNullOrEmpty(x.ProductCode) && x.ProductCode.Equals(strBarcode, StringComparison.OrdinalIgnoreCase));
            }
            
            // إذا وجدنا مطابقة تامة، نضيف المنتج مباشرة
            if (product != null)
            {
                if (product.ProductId == 0 || product.UnitId == 0)
                {
                    return;
                }

                if (product.CurrentStock <= 0)
                {
                    if (strStatus == "Reject")
                    {
                        return;
                    }
                    if (strStatus == "Warn" && !await ConfirmAsync("يوجد كمية مخزون سالبة، هل تريد المتابعة؟"))
                    {
                        return;
                    }
                }

                UpdateTodoList(product);
                CalculateTotal();
                strBarcode = string.Empty;
                listAutocomplete = null;
                StateHasChanged();
                return;
            }
            
            // إذا لم نجد مطابقة تامة، نعرض قائمة الاقتراحات فقط
            // البحث بالباركود (جزئي)
            listAutocomplete = listProduct
                .Where(u => !string.IsNullOrEmpty(u.Barcode) && u.Barcode.ToLower().Contains(strBarcode.ToLower()))
                .Take(16)
                .ToList();
            
            // إذا لم نجد نتائج بالباركود، نبحث بكود المنتج
            if (!listAutocomplete.Any())
            {
                listAutocomplete = listProduct
                    .Where(u => !string.IsNullOrEmpty(u.ProductCode) && u.ProductCode.ToLower().Contains(strBarcode.ToLower()))
                    .Take(16)
                    .ToList();
            }
            
            // إذا لم نجد نتائج بكود المنتج، نبحث بالاسم
            if (!listAutocomplete.Any())
            {
                listAutocomplete = listProduct
                    .Where(u => !string.IsNullOrEmpty(u.ProductName) && u.ProductName.ToLower().Contains(strBarcode.ToLower()))
                    .Take(16)
                    .ToList();
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في البحث: {ex.Message}");
            Snackbar.Add($"خطأ في البحث: {ex.Message}", Severity.Error);
            listAutocomplete = null;
            return;
        }
    }
    private async Task<bool> ConfirmAsync(string message)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", message);
    }
    
    // تم نقل هذه الدالة للأعلى ودمجها مع UpdateCustomerBalance
    
    private void OnCustomerChangedEvent(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out int customerId))
        {
            master.LedgerId = customerId;
            OnCustomerChanged();
        }
    }
    
    // تم إزالة دالة UpdateFirstCustomerStatus - لا توجد شروط خاصة بالعميل الأول
    
    private void Logout()
    {
        userService.Logout();
        NavigationManager.NavigateTo("/login");
    }
}

