    private async Task ProcessPayment()
    {
        isProcessingPayment = true;
        StateHasChanged();

        try
        {
            // Validation
            if (!productList.Any())
            {
                Snackbar.Add("أضف منتج واحد على الأقل", Severity.Error);
                return;
            }

            foreach (var proItem in productList)
            {
                if (proItem.Qty == 0)
                {
                    Snackbar.Add("لا يمكن إنشاء معاملة بكمية صفر", Severity.Error);
                    return;
                }
            }

            if (master.LedgerId == 0)
            {
                Snackbar.Add("اختر عميل صحيح.", Severity.Error);
                return;
            }

            if (master.GrandTotal == 0)
            {
                Snackbar.Add("المبلغ الإجمالي لا يمكن أن يكون صفر.", Severity.Error);
                return;
            }

            if (master.WarehouseId == 0)
            {
                Snackbar.Add("اختر مستودع", Severity.Error);
                return;
            }

            // شروط خاصة بالعميل ذو الكود 5 (عميل المحل)
            if (IsShopCustomer())
            {
                // عميل المحل يجب أن يدفع كامل المبلغ
                if (paidAmount != master.GrandTotal)
                {
                    Snackbar.Add("عميل المحل يجب أن يدفع كامل المبلغ المستحق", Severity.Error);
                    return;
                }
            }

            if (paidAmount <= 0)
            {
                Snackbar.Add("أدخل المبلغ المدفوع", Severity.Error);
                return;
            }

            // التحقق من المبلغ المدفوع بناءً على الرصيد السابق
            decimal maxAllowedPayment;
            if (selectedCustomerBalance > 0)
            {
                // العميل عليه رصيد سابق: يمكنه الدفع حتى (مبلغ الفاتورة + الرصيد السابق)
                maxAllowedPayment = master.GrandTotal + selectedCustomerBalance;
                if (paidAmount > maxAllowedPayment)
                {
                    Snackbar.Add($"المبلغ المدفوع ({paidAmount:N2}) أكبر من المسموح ({maxAllowedPayment:N2}). الحد الأقصى = مبلغ الفاتورة ({master.GrandTotal:N2}) + الرصيد السابق ({selectedCustomerBalance:N2})", Severity.Error);
                    return;
                }
            }
            else
            {
                // العميل ليس عليه رصيد سابق: لا يمكنه الدفع أكثر من مبلغ الفاتورة
                maxAllowedPayment = master.GrandTotal;
                if (paidAmount > maxAllowedPayment)
                {
                    Snackbar.Add($"المبلغ المدفوع ({paidAmount:N2}) أكبر من مبلغ الفاتورة المستحق ({maxAllowedPayment:N2})", Severity.Error);
                    return;
                }
            }
            
            // Set payment details
            master.PayAmount = paidAmount;
            master.BalanceDue = Math.Max(0, master.GrandTotal - paidAmount);

            // Process payment based on method
            await ProcessPaymentByMethod();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في معالجة الدفع: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessingPayment = false;
            StateHasChanged();
        }
    }

    private async Task ProcessPaymentByMethod()
    {
        var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(master.VoucherTypeId);
        string strSerialNo = await salesInvoiceService.GetSerialNo();
        master.VoucherNo = $"{invoice.Suffix ?? string.Empty}-{strSerialNo}-{invoice.Prefix ?? string.Empty}";
        master.SerialNo = strSerialNo;

        // Prepare product details
        master.listOrder.Clear();
        foreach (var item in productList)
        {
            if (item.ProductId > 0)
            {
                var details = new SalesDetails
                {
                    ProductId = item.ProductId,
                    Qty = item.Qty,
                    UnitId = item.UnitId,
                    Rate = item.SalesRate,
                    Discount = item.Discount,
                    DiscountAmount = item.DiscountAmount,
                    TaxId = item.TaxId == 0 ? 1 : item.TaxId,
                    TaxRate = item.TaxRate,
                    TaxAmount = item.TaxAmount,
                    BatchId = item.BatchId,
                    GrossAmount = item.GrossAmount,
                    NetAmount = item.NetAmount,
                    Amount = item.Amount,
                    OrderDetailsId = item.OrderDetailsId
                };
                master.listOrder.Add(details);
            }
        }

        // Set payment method
        switch (selectedPaymentMethod)
        {
            case "Cash":
                master.PaymentId = 1;
                master.PaymentStatus = "Cash";
                break;
            case "Card":
                master.PaymentId = 2;
                master.PaymentStatus = "Card";
                break;
            case "UPI":
                master.PaymentId = 3;
                master.PaymentStatus = "UPI";
                break;
        }

        master.Status = "Pending";

        // Save the transaction
        int result = await salesInvoiceService.SaveAsync(master);

        if (result > 0)
        {
            // Save receive payment if amount is greater than 0
            if (paidAmount > 0)
            {
                await SaveReceivePaymentAsync(result, paidAmount);
            }

            // Link sale to open register
            await LinkSaleToOpenRegister(result, master.PaymentId);

            Snackbar.Add("تم إنشاء فاتورة المبيعات بنجاح.", Severity.Success);
            
            // Show print preview modal
            id = result;
            master.SalesMasterId = result;
            IsModalVisiblePrint = true;

            // Don't reset form yet - wait for user decision
        }
        else
        {
            Snackbar.Add("معاملة غير صحيحة.", Severity.Info);
        }
    }

    private async Task SaveReceivePaymentAsync(int salesId, decimal paidAmount)
    {
        try
        {
            ReceiptMaster paymentMaster = new ReceiptMaster();
            const int ReceivePaymentVoucherTypeId = 3;

            var invoice = await invoiceSettingService.GetInvoiceSettingByIdAsync(ReceivePaymentVoucherTypeId);
            string serialNo = await paymentinService.GetSerialNo();

            paymentMaster.Date = DateTimeHelper.Now;
            paymentMaster.VoucherNo = $"{invoice.Prefix}{serialNo}{invoice.Suffix}";
            paymentMaster.SerialNo = serialNo;
            paymentMaster.LedgerId = master.LedgerId;
            paymentMaster.VoucherTypeId = ReceivePaymentVoucherTypeId;
            paymentMaster.UserId = master.UserName;
            paymentMaster.FinancialYearId = company.FinancialYearId;
            paymentMaster.SalesMasterId = salesId;
            paymentMaster.Narration = master.Narration ?? string.Empty;
            paymentMaster.Type = "CustomerPayment";
            paymentMaster.Status = "Paid";
            paymentMaster.PaidAmount = paidAmount;
            paymentMaster.Amount = paidAmount;
            paymentMaster.AddedDate = DateTimeHelper.Now;

            ReceiptDetails details = new ReceiptDetails
            {
                LedgerId = 1,
                SalesMasterId = salesId,
                TotalAmount = master.GrandTotal,
                ReceiveAmount = paidAmount,
                DueAmount = Math.Max(0, master.GrandTotal - paidAmount)
            };

            paymentMaster.listOrder.Add(details);
            int result = await paymentinService.SaveAsync(paymentMaster);

            if (result <= 0)
            {
                throw new Exception("فشل في حفظ معلومات الدفع.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطأ في حفظ معلومات الدفع: {ex.Message}");
            throw;
        }
    }

    private async Task LinkSaleToOpenRegister(int salesMasterId, int paymentMethodId)
    {
