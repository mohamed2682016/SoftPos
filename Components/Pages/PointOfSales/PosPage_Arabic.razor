        else
        {
            // Perform case-insensitive partial match search
            listProduct = listProduct
                .Where(p => p.ProductName != null &&
                            p.ProductName.IndexOf(strsearch, StringComparison.OrdinalIgnoreCase) >= 0)
                .ToList();
        }

        // Trigger a UI refresh
        StateHasChanged();
    }
