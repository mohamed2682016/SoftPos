@page "/product/add-ar"
@page "/product/{id:int}-ar"
@inject ProductService productService
@inject TaxService taxService
@inject CategoryService categoryService
@inject SoftPos.Utilities.BarcodeNumberService BarcodeNumberService
@inject UnitService unitService
@inject BrandService brandService
@inject WarehouseService warehouseService
@inject NavigationManager NavigationManager
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@using SoftPos.Utilities
<div class="container mt-4" dir="rtl">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>المنتج | إضافة</h4>
        <a class="btn btn-secondary" href="/product-ar">
            <i class="fas fa-arrow-right me-2"></i> رجوع
        </a>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">تفاصيل المنتج</h5>
        </div>
        <div class="card-body">
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <!-- Warehouse -->
                    <div class="col-lg-4 col-md-6">
                        <label>المستودع<span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.WarehouseId">
                            @if (listWarehouse != null)
                            {
                                @foreach (var warehouse in listWarehouse)
                                {
                                    <option value="@warehouse.WarehouseId">@warehouse.Name</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => model.WarehouseId)" />
                    </div>

                    <!-- Product Name -->
                    <div class="col-lg-4 col-md-6">
                        <label>اسم المنتج<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="model.ProductName" placeholder="أدخل اسم المنتج">
                        <ValidationMessage For="@(() => model.ProductName)" />
                    </div>

                    <!-- Barcode -->
                    <div class="col-lg-4 col-md-6">
                        <label>الباركود<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="model.ProductCode" placeholder="أدخل الباركود">
                        <ValidationMessage For="@(() => model.ProductCode)" />
                    </div>

                    <!-- Category -->
                    <div class="col-lg-4 col-md-6">
                        <label>الفئة<span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.GroupId">
                            @if (listCategory != null)
                            {
                                @foreach (var category in listCategory)
                                {
                                    <option value="@category.GroupId">@category.GroupName</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => model.GroupId)" />
                    </div>

                    <!-- Unit -->
                    <div class="col-lg-4 col-md-6">
                        <label>الوحدة<span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.UnitId">
                            @if (listUnit != null)
                            {
                                @foreach (var unit in listUnit)
                                {
                                    <option value="@unit.UnitId">@unit.UnitName</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => model.UnitId)" />
                    </div>

                    <!-- Purchase Rate -->
                    <div class="col-lg-4 col-md-6">
                        <label>سعر الشراء<span class="text-danger">*</span></label>
                        <div class="d-flex align-items-start gap-2">
                            <input type="text" class="form-control" @bind="model.PurchaseRate" placeholder="أدخل سعر الشراء">
                            <select class="form-select" @bind="model.Includingpurchasetax">
                                <option value="Excluding">بدون ضريبة</option>
                                <option value="Including">شامل الضريبة</option>
                            </select>
                        </div>
                        <ValidationMessage For="@(() => model.PurchaseRate)" />
                    </div>

                    <!-- Sales Rate -->
                    <div class="col-lg-4 col-md-6">
                        <label>سعر البيع<span class="text-danger">*</span></label>
                        <div class="d-flex align-items-start gap-2">
                            <input type="text" class="form-control" @bind="model.SalesRate" placeholder="أدخل سعر البيع">
                            <select class="form-select" @bind="model.Includingsalestax">
                                <option value="Excluding">بدون ضريبة</option>
                                <option value="Including">شامل الضريبة</option>
                            </select>
                        </div>
                        <ValidationMessage For="@(() => model.SalesRate)" />
                    </div>

                    <!-- MRP -->
                    <div class="col-lg-4 col-md-6">
                        <label>السعر الأقصى للبيع</label>
                        <input type="text" class="form-control" @bind="model.Mrp" placeholder="أدخل السعر الأقصى">
                        <ValidationMessage For="@(() => model.Mrp)" />
                    </div>

                    <!-- Opening Stock -->
                    <div class="col-lg-4 col-md-6">
                        <label>المخزون الافتتاحي</label>
                        <input type="text" class="form-control" @bind="model.OpeningStock" placeholder="أدخل المخزون الافتتاحي">
                        <ValidationMessage For="@(() => model.OpeningStock)" />
                    </div>

                    <!-- Qty Alert -->
                    <div class="col-lg-4 col-md-6">
                        <label>تنبيه الكمية</label>
                        <input type="number" class="form-control" @bind="model.QtyAlert" placeholder="أدخل حد التنبيه">
                        <ValidationMessage For="@(() => model.QtyAlert)" />
                    </div>

                    <!-- Expiry Date -->
                    <div class="col-lg-4 col-md-6">
                        <label>تاريخ الانتهاء</label>
                        <InputDate class="form-control" @bind-Value="@model.ExpiryDate" />
                        <ValidationMessage For="@(() => model.ExpiryDate)" />
                    </div>

                    <!-- Product Type -->
                    <div class="col-lg-3 col-md-4">
                        <label>نوع المنتج<span class="text-danger">*</span></label>
                        <select @bind="model.ProductType" class="form-select">
                            <option value="Product">منتج</option>
                            <option value="Service">خدمة</option>
                            <option value="RawMaterial">مادة خام</option>
                        </select>
                        <ValidationMessage For="@(() => model.ProductType)" />
                    </div>

                    <!-- HSN Code -->
                    <div class="col-lg-3 col-md-4">
                        <label>كود HSN</label>
                        <input type="text" class="form-control" @bind="model.HsnCode" placeholder="أدخل كود HSN">
                        <ValidationMessage For="@(() => model.HsnCode)" />
                    </div>

                    <!-- Brand -->
                    <div class="col-lg-3 col-md-4">
                        <label>العلامة التجارية<span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.BrandId">
                            @if (listBrand != null)
                            {
                                @foreach (var brand in listBrand)
                                {
                                    <option value="@brand.BrandId">@brand.Name</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => model.BrandId)" />
                    </div>

                    <!-- Tax -->
                    <div class="col-lg-3 col-md-4">
                        <label>الضريبة<span class="text-danger">*</span></label>
                        <select class="form-select" @bind="model.TaxId">
                            @if (listTax != null)
                            {
                                @foreach (var tax in listTax)
                                {
                                    <option value="@tax.TaxId">@tax.TaxName</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(() => model.TaxId)" />
                    </div>

                    <!-- Narration -->
                    <div class="col-12">
                        <label>الوصف</label>
                        <textarea class="form-control" @bind="model.Narration" rows="3" placeholder="أدخل وصف المنتج"></textarea>
                        <ValidationMessage For="@(() => model.Narration)" />
                    </div>

                    <!-- Product Image -->
                    <div class="col-12">
                        <label>صورة المنتج</label>
                        <div class="image-uploads mb-2">
                            @if (string.IsNullOrEmpty(model.Image))
                            {
                                <img src="/img/noimage.png" height="80" width="80" class="border rounded">
                            }
                            else
                            {
                                <img src="@model.Image" width="80" height="80" class="border rounded">
                            }
                        </div>
                        <InputFile OnChange="OnFileChange" class="form-control" />
                        <ValidationMessage For="@(() => model.Image)" />
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>حفظ
                            </button>
                            <a href="/product-ar" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>إلغاء
                            </a>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }
    
    private Product model = new Product();
    private List<ProductGroupView> listCategory = new();
    private List<Brand> listBrand = new();
    private List<Unit> listUnit = new();
    private List<Warehouse> listWarehouse = new();
    private List<Tax> listTax = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            listCategory = await categoryService.GetAllProductGroupsAsync();
            listBrand = await brandService.GetAllBrandsAsync();
            listUnit = await unitService.GetAllUnitsAsync();
            listWarehouse = await warehouseService.GetAllWarehousesAsync();
            listTax = await taxService.GetAllTaxsAsync();

            if (id == 0)
            {
                // New product - Set default values
                // Find "قطعة" unit or use first unit
                var defaultUnit = listUnit.FirstOrDefault(u => u.UnitName == "قطعة") ?? listUnit.FirstOrDefault();
                // Use first warehouse
                var defaultWarehouse = listWarehouse.FirstOrDefault();
                // Use first tax
                var defaultTax = listTax.FirstOrDefault();
                // Use first category
                var defaultCategory = listCategory.FirstOrDefault();
                // Use first brand
                var defaultBrand = listBrand.FirstOrDefault();

                model = new Product
                {
                    ProductId = 0,
                    ProductCode = BarcodeNumberService.GenerateBarcodeNumber(),
                    ProductType = "Product",
                    GroupId = defaultCategory?.GroupId ?? 0,
                    BrandId = defaultBrand?.BrandId ?? 0,
                    UnitId = defaultUnit?.UnitId ?? 0,
                    WarehouseId = defaultWarehouse?.WarehouseId ?? 0,
                    TaxId = defaultTax?.TaxId ?? 0,
                    PurchaseRate = 1,
                    SalesRate = 1,
                    Mrp = 1,
                    QtyAlert = 2,
                    Includingpurchasetax = "Excluding",
                    Includingsalestax = "Excluding",
                    AddedDate = DateTimeHelper.Now,
                    ExpiryDate = DateTimeHelper.Now.AddYears(1)
                };
            }
            else
            {
                // Edit existing product
                model = await productService.GetProductByIdAsync(id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }

    private async Task Save()
    {
        try
        {
            var originalCode = model.ProductCode;
            
            if (model.ProductId == 0)
            {
                // Add new product
                int result = await productService.AddProductAsync(model);
                if (result > 0)
                {
                    if (originalCode != model.ProductCode)
                    {
                        Snackbar.Add($"تم إنشاء المنتج بنجاح. تم تغيير الكود إلى: {model.ProductCode}", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("تم إنشاء المنتج بنجاح", Severity.Success);
                    }
                    NavigationManager.NavigateTo("/product-ar");
                }
                else
                {
                    Snackbar.Add("فشل في إنشاء المنتج.", Severity.Error);
                }
            }
            else
            {
                // Update existing product
                bool isUpdated = await productService.UpdateProductAsync(model);
                if (isUpdated)
                {
                    if (originalCode != model.ProductCode)
                    {
                        Snackbar.Add($"تم تحديث المنتج بنجاح. تم تغيير الكود إلى: {model.ProductCode}", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add("تم تحديث المنتج بنجاح", Severity.Success);
                    }
                    NavigationManager.NavigateTo("/product-ar");
                }
                else
                {
                    Snackbar.Add("فشل في تحديث المنتج.", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في حفظ المنتج: {ex.Message}", Severity.Error);
        }
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            var format = "image/png";
            var resizedImage = await e.File.RequestImageFileAsync(format, 300, 300);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            var imageData = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            model.Image = imageData;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في رفع الصورة: {ex.Message}", Severity.Error);
        }
    }
}