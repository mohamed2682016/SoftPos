@page "/expiring-products"
@using SoftPos.Services
@using SoftPos.Data.Setting
@inject ExpiryNotificationService ExpiryService
@inject NavigationManager Navigation

<div class="container-fluid" dir="rtl" style="font-family: 'Cairo', sans-serif;">
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="text-warning">
                <i class="fas fa-clock me-2"></i>
                المنتجات القريبة من انتهاء الصلاحية
            </h3>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">عرض المنتجات التي تنتهي خلال:</label>
            <select class="form-select" @bind="DaysThreshold" @bind:after="LoadData">
                <option value="7">7 أيام</option>
                <option value="15">15 يوم</option>
                <option value="30">30 يوم</option>
                <option value="60">60 يوم</option>
                <option value="90">90 يوم</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">قائمة المنتجات (خلال @DaysThreshold يوم)</h5>
                </div>
                <div class="card-body">
                    @if (ExpiringProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>كود المنتج</th>
                                        <th>اسم المنتج</th>
                                        <th>تاريخ الصلاحية</th>
                                        <th>الأيام المتبقية</th>
                                        <th>الحالة</th>
                                        <th>المخزون</th>
                                        <th>سعر البيع</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in ExpiringProducts)
                                    {
                                        var daysRemaining = ExpiryService.GetDaysUntilExpiry(product) ?? 0;
                                        var status = ExpiryService.GetExpiryStatus(product);
                                        var rowClass = status == ExpiryStatus.CriticalExpiring ? "table-danger" : 
                                                      status == ExpiryStatus.Expiring ? "table-warning" : "";
                                        
                                        <tr class="@rowClass">
                                            <td>@product.ProductCode</td>
                                            <td>@product.ProductName</td>
                                            <td>@product.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge @GetBadgeClass(daysRemaining)">
                                                    @daysRemaining يوم
                                                </span>
                                            </td>
                                            <td>
                                                @if (status == ExpiryStatus.CriticalExpiring)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-exclamation-triangle"></i> حرج
                                                    </span>
                                                }
                                                else if (status == ExpiryStatus.Expiring)
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-exclamation-circle"></i> تحذير
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check"></i> جيد
                                                    </span>
                                                }
                                            </td>
                                            <td>@product.OpeningStock</td>
                                            <td>@product.SalesRate.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="alert alert-info">
                                <strong>إجمالي المنتجات:</strong> @ExpiringProducts.Count منتج
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success text-center">
                            <i class="fas fa-check-circle me-2"></i>
                            لا توجد منتجات قريبة من انتهاء الصلاحية خلال @DaysThreshold يوم
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="fas fa-arrow-right me-2"></i>
                رجوع
            </button>
        </div>
    </div>
</div>

@code {
    private List<Product> ExpiringProducts { get; set; } = new();
    private int DaysThreshold { get; set; } = 30;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        ExpiringProducts = await ExpiryService.GetExpiringProductsAsync(DaysThreshold);
    }

    private string GetBadgeClass(int daysRemaining)
    {
        if (daysRemaining <= 7)
            return "bg-danger";
        else if (daysRemaining <= 15)
            return "bg-warning";
        else
            return "bg-info";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }
}
