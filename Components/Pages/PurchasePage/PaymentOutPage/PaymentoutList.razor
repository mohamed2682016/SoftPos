@page "/payment-out"
@inject PaymentOutService paymentoutService
@inject AccountLedgerService accountledgerService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@using SoftPos.Utilities
<div class="container mt-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4>دفعة صادرة</h4>
        </div>
        <div class="col text-end">
            <a class="btn btn-primary" href="/payment-out/add">
                <i class="fas fa-plus me-2"></i> إنشاء
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <!-- From Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                من تاريخ
                                <InputDate class="form-control" @bind-Value="fromDate" />
                            </div>
                        </div>

                        <!-- To Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                إلى تاريخ
                                <InputDate class="form-control" @bind-Value="endDate" />
                            </div>
                        </div>

                        <!-- Supplier Dropdown -->
                        <div class="col-lg-4 col-sm-6 col-12">
                            <div class="form-group">
                                المورد
                                <select class="form-select" @bind="ledgerId">
                                    <option value="0">اختر</option>
                                    @if (listAccountLedger != null)
                                    {
                                        @foreach (var supplier in listAccountLedger)
                                        {
                                            <option value="@supplier.LedgerId">@supplier.LedgerName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Search Button -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group" style="margin-top: 20px;">
                                <button class="btn btn-primary" @onclick="LoadData">
                                    <i class="fas fa-search"></i> بحث
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <MudTable Items="listPaymentOut" Dense="dense" Hover="hover">
                    <HeaderContent>
                        <MudTh>التاريخ</MudTh>
                        <MudTh>رقم الإيصال</MudTh>
                        <MudTh>اسم المورد</MudTh>
                        <MudTh>المبلغ</MudTh>
                        <MudTh>الحالة</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date</MudTd>
                        <MudTd DataLabel="VoucherNo">@context.VoucherNo</MudTd>
                        <MudTd DataLabel="LedgerName">@context.LedgerName</MudTd>
                        <MudTd DataLabel="Amount">@context.Amount</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="">
                            <!-- Dropdown Actions -->
                            <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-bars me-1"></i>
                            </button>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href="/payment-out/details/@context.PaymentMasterId">
                                    <i class="fas fa-eye"></i> عرض
                                </a>
                                <a class="dropdown-item text-danger" @onclick="() => Delete(context)">
                                    <i class="fas fa-trash"></i> حذف
                                </a>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    </div>
</div>

@code {
    private bool dense = true;
    private bool hover = true;
    private List<PaymentReceiveView> listPaymentOut = new();
    private List<AccountLedgerView> listAccountLedger;
    private DateTime fromDate { get; set; }
    private DateTime endDate { get; set; } 
    private int ledgerId = 0;

    protected override async Task OnInitializedAsync()
    {
        listAccountLedger = await accountledgerService.GetAllAccountLedgersByIdAsync(22);
        fromDate = DateTimeHelper.Now.AddDays(-7);
        endDate = DateTimeHelper.Now;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            listPaymentOut = await paymentoutService.PaymentViewAllAsync(fromDate, endDate, ledgerId, "SupplierPayment");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }

    private async Task Delete(PaymentReceiveView view)
    {
        try
        {
            // Show a confirmation dialog
            bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف هذه الدفعة الصادرة؟");
            if (!confirmed) return;

            // Attempt to delete the purchase
            bool isDeleted = await paymentoutService.DeletePaymentOutAsync(view);

            if (isDeleted)
            {
                Snackbar.Add("تم حذف الدفعة الصادرة بنجاح.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("لا يمكن حذف هذه الدفعة الصادرة لأنها قيد الاستخدام.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء حذف الدفعة الصادرة: {ex.Message}", Severity.Error);
        }
    }
}
