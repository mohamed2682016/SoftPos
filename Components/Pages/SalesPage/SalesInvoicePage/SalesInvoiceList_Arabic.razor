@page "/sales-ar"
@inject SalesInvoiceService salesinvoiceService
@inject AccountLedgerService accountledgerService
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@using SoftPos.Utilities
<div class="container mt-4" dir="rtl">
    <!-- Header Section -->
    <div class="row align-items-center mb-3">
        <div class="col">
            <h4>فواتير المبيعات</h4>
        </div>
        <div class="col text-start">
            <a class="btn btn-primary" href="/sales/add-ar">
                <i class="fas fa-plus me-2"></i> إضافة فاتورة
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <!-- From Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                <label>من تاريخ</label>
                                <InputDate class="form-control" @bind-Value="fromDate" />
                            </div>
                        </div>

                        <!-- To Date -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                <label>إلى تاريخ</label>
                                <InputDate class="form-control" @bind-Value="endDate" />
                            </div>
                        </div>

                        <!-- Customer Dropdown -->
                        <div class="col-lg-4 col-sm-6 col-12">
                            <div class="form-group">
                                <label>العميل</label>
                                <select class="form-select" @bind="ledgerId">
                                    <option value="0">اختر</option>
                                    @if (listAccountLedger != null)
                                    {
                                        @foreach (var customer in listAccountLedger)
                                        {
                                            <option value="@customer.LedgerId">@customer.LedgerName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Status Dropdown -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group">
                                <label>الحالة</label>
                                <select class="form-select" @bind="strStatus">
                                    <option value="All">الكل</option>
                                    <option value="Pending">معلقة</option>
                                    <option value="PartialPaid">مدفوعة جزئياً</option>
                                    <option value="Paid">مدفوعة</option>
                                </select>
                            </div>
                        </div>

                        <!-- Search Button -->
                        <div class="col-lg-2 col-sm-6 col-12">
                            <div class="form-group" style="margin-top: 20px;">
                                <button class="btn btn-primary" @onclick="LoadData">
                                    <i class="fas fa-search"></i> بحث
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <MudTable Items="listSalesInvoice" Dense="dense" Hover="hover">
                    <HeaderContent>
                        <MudTh>التاريخ</MudTh>
                        <MudTh>رقم الفاتورة</MudTh>
                        <MudTh>اسم العميل</MudTh>
                        <MudTh>المبلغ</MudTh>
                        <MudTh>طريقة الدفع</MudTh>
                        <MudTh>الرصيد المستحق</MudTh>
                        <MudTh>الحالة</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date</MudTd>
                        <MudTd DataLabel="VoucherNo">@context.VoucherNo</MudTd>
                        <MudTd DataLabel="LedgerName">@context.LedgerName</MudTd>
                        <MudTd DataLabel="GrandTotal">@context.GrandTotal</MudTd>
                        <MudTd DataLabel="PaymentStatus">
                            @if (context.PaymentStatus == "Cash")
                            {
                                <span class="badge bg-success"><i class="fas fa-money-bill me-1"></i>نقدي</span>
                            }
                            else if (context.PaymentStatus == "Card")
                            {
                                <span class="badge bg-primary"><i class="fas fa-credit-card me-1"></i>بطاقة</span>
                            }
                            else if (context.PaymentStatus == "UPI")
                            {
                                <span class="badge bg-info"><i class="fas fa-wallet me-1"></i>محفظة</span>
                            }
                            else if (context.PaymentStatus == "CreditSales")
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-handshake me-1"></i>آجل</span>
                            }
                            else if (context.PaymentStatus == "Hold")
                            {
                                <span class="badge bg-secondary"><i class="fas fa-pause me-1"></i>معلق</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@context.PaymentStatus</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="BalanceDue">@context.BalanceDue</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="">
                            <!-- Dropdown Actions -->
                            <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-bars me-1"></i>
                            </button>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href="/sales/details/@context.SalesMasterId">
                                    <i class="fas fa-eye"></i> عرض
                                </a>
                                <a class="dropdown-item" href="/sales/edit/@context.SalesMasterId">
                                    <i class="fas fa-edit"></i> تعديل
                                </a>
                                @if (context.Status == "Pending" || context.Status == "PartialPaid")
                                {
                                    <a class="dropdown-item" href="/payment-in/@context.SalesMasterId">
                                        <i class="fas fa-money-bill"></i> إنشاء دفعة
                                    </a>
                                }
                                <a class="dropdown-item" href="/sales-return/add/@context.SalesMasterId">
                                    <i class="fa fa-angle-double-left"></i> مرتجع مبيعات
                                </a>
                                <a class="dropdown-item text-danger" @onclick="() => Delete(context)">
                                    <i class="fas fa-trash"></i> حذف
                                </a>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    </div>
</div>

@code {
    private bool dense = true;
    private bool hover = true;
    private List<SalesMasterView> listSalesInvoice = new();
    private List<AccountLedgerView> listAccountLedger;
    private DateTime fromDate { get; set; }
    private DateTime endDate { get; set; } 
    private int ledgerId = 0;
    private string strStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        listAccountLedger = await accountledgerService.GetAllAccountLedgersByIdAsync(26);
        fromDate = DateTimeHelper.Now.AddDays(-7);
        endDate = DateTimeHelper.Now;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            listSalesInvoice = await salesinvoiceService.SalesInvoiceSearchAsync(fromDate, endDate, ledgerId, strStatus);
            // ترتيب الفواتير من الأحدث للأقدم
            listSalesInvoice = listSalesInvoice.OrderByDescending(x => x.Date).ThenByDescending(x => x.SalesMasterId).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطأ في تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }

    private async Task Delete(SalesMasterView view)
    {
        try
        {
            // Show a confirmation dialog
            bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "هل أنت متأكد من حذف فاتورة المبيعات هذه؟");
            if (!confirmed) return;

            // Attempt to delete the sales
            bool isDeleted = await salesinvoiceService.DeleteSalesInvoiceAsync(view);

            if (isDeleted)
            {
                Snackbar.Add("تم حذف فاتورة المبيعات بنجاح.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("لا يمكن حذف فاتورة المبيعات لأنها مستخدمة في العمليات.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء حذف فاتورة المبيعات: {ex.Message}", Severity.Error);
        }
    }
}